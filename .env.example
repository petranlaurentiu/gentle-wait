# Public app configuration
# These values are intentionally available to the app at runtime.
EXPO_PUBLIC_API_ORIGIN=https://your-production-api.example.com
EXPO_PUBLIC_APPLE_TEAM_ID=CNS3PJ66YR
EXPO_PUBLIC_IOS_APP_GROUP=group.com.petran-laurentiu.gentlewait

# RevenueCat — replace test_ keys with production keys before App Store submission
REVENUECAT_APPLE_PUBLIC_SDK_KEY=appl_your_revenuecat_production_key
REVENUECAT_GOOGLE_PUBLIC_SDK_KEY=goog_your_revenuecat_production_key

# Server-only secrets — set via EAS Secrets for production builds, never commit real values
# OPENROUTER_API_KEY=sk-or-v1-...

# Shared secret for HMAC request signing (must match on client and server)
# AI_REQUEST_SECRET=your-random-secret-here
